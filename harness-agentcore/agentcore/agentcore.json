{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "tifsharness",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "tifsharness"
  },
  "runtimes": [
    {
      "name": "lpagent",
      "build": "Container",
      "entrypoint": "main.py",
      "codeLocation": "app/lpagent/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "envVars": [
        {
          "name": "TI_FS_TOKEN_SECRET_ID",
          "value": "tifsharness/ti-fs-token"
        },
        {
          "name": "TI_REGION_CODE",
          "value": "aws-ap-southeast-1"
        }
      ],
      "additionalPolicies": [
        "secrets-policy.json"
      ]
    }
  ],
  "memories": [],
  "knowledgeBases": [],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": [],
  "configBundles": [],
  "abTests": [],
  "harnesses": [],
  "datasets": [],
  "capacityProviders": [],
  "payments": []
}